# dependencies
node_modules/

# Python
__pycache__/
*.pyc
.venv/
venv/

# the scraper's raw downloaded XML — regenerable, large, never committed
israel-poc/dumps/
israel-poc/*_cookies.txt
israel-poc/logging.log
# the scraper writes this wherever it is run from, including the repo root
logging.log
israel-poc/status/

# OS / editor noise
.DS_Store
Thumbs.db

# secrets — never commit real credentials
.env
!*.env.example

# Generated design-review sheet. `npm run preview` in web/ builds it by
# rendering the real Can component through the web shim, so it cannot drift
# from what ships; it replaced a Python script that re-parsed Can.tsx.

# Staged-geocoder cache. Per-machine working state; the results that matter
# are exported into data/geocode-cache.json, which IS committed.
data/geocode-stages.sqlite

# Regenerated on demand by israel-poc/dump_locations.py.
data/locations.txt

# Built app bundles. Downloaded from EAS on demand; too large to track.
build/

# Regenerated on demand by israel-poc/dump_solvable.py.
data/unresolved.txt
web/.preview/

# Parsed archive cache. Kept across CI runs by actions/cache, never
# committed — it is 1 GB of downloaded CSV in parsed form and the archive
# will hand it back for free. See pipeline.ARCHIVE_CACHE.
israel-poc/.archive-cache.json
